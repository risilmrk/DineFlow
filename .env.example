# ==============================================================================
# DineFlow SaaS Environment Template (.env.example)
# ==============================================================================

# Public Client Configuration (VITE_)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_BASE_DOMAIN=localhost:5173
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Server-Side Secrets (NEVER prefix with VITE_ or expose to client)
# Used by Supabase Edge Functions & REST API Layer
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key
DEFAULT_FROM_EMAIL=invitations@dineflow.com
